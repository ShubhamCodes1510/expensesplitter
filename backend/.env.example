# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/expense_splitter?createDatabaseIfNotExist=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# JWT Secret - Generate a random string (min 32 characters)
# Example: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret_key_at_least_32_chars

# JWT Token Expiration (default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Email Configuration (optional)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Swagger (set to true to enable in development)
SWAGGER_ENABLED=false
